# MariaDB 컨테이너 비밀번호 (DB명/계정명은 docker-compose.yml에 고정되어 있어 여기 포함하지 않음)
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme

# 파일 업로드 저장 루트 (컨테이너 내부 경로, ./data/uploads bind mount 대상과 일치해야 함)
UPLOAD_ROOT=/app/uploads

# 초기 관리자 계정 (최초 기동 시 계정이 없을 때만 생성됨)
# 비밀번호 정책: 8자 이상 + 영문/숫자/특수문자 중 2종 이상 조합 (CODING_RULES.md)
ADMIN_LOGIN_ID=changeme
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=관리자
