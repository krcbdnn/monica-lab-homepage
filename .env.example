# 운영 환경변수 template. 값을 채운 사본을 .env로 저장한다(.env는 gitignore 대상, 저장소에 커밋하지 않는다).
# 아래 5개는 모두 필수이며, 비어 있으면 docker compose가 즉시 실패한다(fail-fast).
# 비밀번호 생성 예: openssl rand -base64 24

# MariaDB 컨테이너 비밀번호 (DB명/계정명은 docker-compose.yml에 고정되어 있어 여기 포함하지 않음)
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# 초기 관리자 계정 (최초 기동 시 계정이 없을 때만 생성됨, 이후 .env 변경은 DB에 반영되지 않음)
# 비밀번호 정책: 8자 이상 + 영문/숫자/특수문자 중 2종 이상 조합 (CODING_RULES.md)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=
